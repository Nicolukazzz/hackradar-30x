# Copiar a .env y llenar. Nunca commitear .env.

# LLM (detrás de interfaz intercambiable, src/extraccion/llm/). gemini | groq | ninguno
# Cadena: el elegido → el otro con llave → ninguno (R1 escala lo que falte). anthropic aún no implementado.
LLM_PROVIDER=gemini
GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free tier)
GEMINI_MODEL=          # opcional; por defecto gemini-flash-latest
GROQ_API_KEY=          # https://console.groq.com/keys (free tier, respaldo)
GROQ_MODEL=            # opcional; por defecto meta-llama/llama-4-scout-17b-16e-instruct
ANTHROPIC_API_KEY=     # opcional, solo si hay créditos (Claude Pro NO sirve aquí)

# Canales
TELEGRAM_BOT_TOKEN=    # @BotFather

# Persistencia. memoria | supabase (supabase aún es stub, #17)
REPOSITORIO=memoria
ESCENARIO=lote-demo-oct   # escenario de data/escenarios que carga el repositorio en memoria
DEMO=                     # 1 = en producción habilita "Actuar como" y reiniciar la demo (sin login: solo para presentar; en dev siempre activo)
EXTRACCION=golden         # golden = extracción esperada (demo exacta, sin LLM) · real = extractor de #4
SUPABASE_URL=          # proyecto en la cuenta Supabase del equipo (NO cuentas personales)
SUPABASE_ANON_KEY=

# MCP 21st.dev (Claude Code, no la app): va como variable de la shell, no en .env.
# fish: set -Ux API_KEY_21ST <llave>   ·  bash/zsh: export API_KEY_21ST=<llave>
# Llave gratis en https://21st.dev/mcp
