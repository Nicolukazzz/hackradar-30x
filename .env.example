# Copiar a .env y llenar. Nunca commitear .env.

# LLM (detrás de interfaz intercambiable, src/extraccion/llm/). gemini | anthropic | doble | ninguno (Groq desactivado, #129)
# Cadena: el elegido → los demás con llave → ninguno (R1 escala lo que falte).
# doble (#58): Gemini y Claude Haiku leen en paralelo y un campo vale solo si coinciden 2 de 3 (con el parser);
# si falta una llave, Groq reemplaza a ese lector; con un solo proveedor, cadena simple.
LLM_PROVIDER=gemini
GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free tier)
GEMINI_MODEL=          # opcional; lista separada por comas, se prueba en orden si uno falla (503/429/404).
                       # Por defecto: gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
GROQ_API_KEY=          # sin uso: Groq está desactivado (#129)
GROQ_MODEL=            # opcional; lista separada por comas como GEMINI_MODEL. Por defecto meta-llama/llama-4-scout-17b-16e-instruct
ANTHROPIC_API_KEY=     # Claude Haiku 5.5 para la doble lectura (#58). Claude Pro NO sirve aquí: API aparte, prepago
ANTHROPIC_MODEL=       # opcional; por defecto claude-haiku-5-5

# Canales
# Chat de proveedores: Telegram (#13) y WhatsApp Cloud API (#79). Webhook de Meta: <URL>/api/canales/whatsapp/webhook
WHATSAPP_TOKEN=        # token de acceso de la app de Meta (el de "Paso 1. Probar" vence en 24 h; usar uno de usuario del sistema)
WHATSAPP_PHONE_ID=     # Phone Number ID del número de WhatsApp Business
WHATSAPP_NUMERO=       # el mismo número en dígitos, sin + (para los enlaces wa.me/<numero>?text=VINCULAR …)
WHATSAPP_VERIFY_TOKEN= # cadena aleatoria larga: verifica el webhook (GET) y firma los enlaces de vinculación
WHATSAPP_APP_SECRET=   # clave secreta de la app (Configuración > Básica): verifica X-Hub-Signature-256 de cada POST
TELEGRAM_BOT_TOKEN=    # @BotFather → /newbot (#13)
TELEGRAM_BOT_USUARIO=  # @usuario del bot, sin @ (para los enlaces t.me/<bot>?start=…)
TELEGRAM_WEBHOOK_SECRET= # cadena aleatoria larga: verifica el webhook y firma los enlaces de vinculación
# Registrar el webhook: npm run telegram -- webhook · Enlace para un proveedor: npm run telegram -- enlace ben-diego-herrera
# Aviso a aprobadores cuando el agente escala (#68): correo por el SMTP del buzón (CORREO_IMAP_*, abajo) a quien
# puede aprobar el monto y, si se pone, un mensaje a Teams. Sin buzón ni Teams no se avisa nada.
TEAMS_WEBHOOK_URL=     # opcional; URL del flujo "Post to a channel when a webhook request is received" (Teams Workflows)
AVISOS=                # 0 = no avisar aunque haya buzón o Teams
# Correo entrante (#14): buzón Gmail del equipo por IMAP (leer, cada minuto dentro del proceso web) y SMTP
# (responder). Clave de aplicación de Google, no la contraseña. Sin estas dos, solo funciona /api/canales/correo/simular.
CORREO_IMAP_USUARIO=   # facturas…@gmail.com
CORREO_IMAP_CLAVE=     # clave de aplicación de 16 caracteres (Cuenta Google > Seguridad > Contraseñas de aplicaciones)
CORREO_IMAP_HOST=      # opcional; por defecto imap.gmail.com
URL_PUBLICA=           # opcional; base de los enlaces en los avisos. En Railway se usa RAILWAY_PUBLIC_DOMAIN
PORTAL_PROVEEDOR_SECRETO= # opcional; firma la sesión del portal del proveedor (#85). Sin él se deriva de SUPABASE_SECRET_KEY

# Persistencia. memoria (se borra en cada deploy) | supabase (#44: registro, documentos, reglas y archivos en la base;
# necesita NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SECRET_KEY y la migración 20261017090000_repositorio.sql aplicada)
REPOSITORIO=memoria
ESCENARIO=lote-demo-oct   # escenario de data/escenarios que carga el repositorio en memoria
DEMO=                     # 1 = en producción habilita reiniciar la demo (exige sesión del panel; en dev siempre activo)
EXTRACCION=golden         # golden = extracción esperada (demo exacta, sin LLM) · real = extractor de #4

# Supabase Auth (#25): login por OTP y rol desde public.perfiles.
# Cuenta del equipo, NUNCA personal. Dashboard > Project Settings > API Keys.
# La app no arranca (500 en cada página) si faltan las dos NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=              # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # sb_publishable_… (va al navegador, es pública)
SUPABASE_SECRET_KEY=                   # sb_secret_… solo servidor: scripts (npm run auth:sembrar) y REPOSITORIO=supabase. Nunca NEXT_PUBLIC_, nunca al repo.
# Los códigos de /entrar los manda Supabase por SMTP (Auth > SMTP Settings); la app no necesita llave de correo.

# MCP 21st.dev (Claude Code, no la app): va como variable de la shell, no en .env.
# fish: set -Ux API_KEY_21ST <llave>   ·  bash/zsh: export API_KEY_21ST=<llave>
# Llave gratis en https://21st.dev/mcp
