# Copiar a .env y llenar. Nunca commitear .env.

# LLM (detrás de interfaz intercambiable). gemini | groq | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free tier)
GROQ_API_KEY=          # https://console.groq.com/keys (free tier, respaldo)
ANTHROPIC_API_KEY=     # opcional, solo si hay créditos (Claude Pro NO sirve aquí)

# Canales
TELEGRAM_BOT_TOKEN=    # @BotFather
