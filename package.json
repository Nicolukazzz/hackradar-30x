{
  "name": "hackradar-30x",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "evaluar": "tsx scripts/evaluar.ts",
    "extraer": "tsx --env-file-if-exists=.env scripts/extraer.ts",
    "dataset": "$([ -x .venv/bin/python ] && echo .venv/bin/python || echo python3) scripts/dataset/generar.py",
    "cargar-escenario": "tsx --env-file-if-exists=.env scripts/cargar-escenario.ts",
    "test:supabase": "bash scripts/test-supabase.sh",
    "equipo:admin": "tsx --env-file-if-exists=.env scripts/equipo/admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "decimal.js": "^10.6.0",
    "geist": "^1.8.1",
    "imapflow": "^1.4.4",
    "input-otp": "1.5.0",
    "lucide-react": "^1.58.0",
    "mailparser": "^3.9.40",
    "next": "16.4.2",
    "nodemailer": "^7.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
