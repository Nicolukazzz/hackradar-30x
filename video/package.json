  },
  "scripts": {
    "studio": "remotion studio",
    "dev": "remotion studio",
    "render": "remotion render Pitch out/pitch.mp4",
    "render:escenas": "for c in E1-Gancho E2-Problema E3-ComoFunciona E4-Veredictos E5-Bandeja E6-Trampas E7-PersonaDecide E8-Metricas E9-Cierre; do remotion render $c out/escenas/$c.mp4 || exit 1; done",
    "render:rotulo": "remotion render Rotulo out/rotulo.mov --image-format=png --pixel-format=yuva444p10le --codec=prores --prores-profile=4444",
    "render:todo": "npm run render && npm run render:escenas && npm run render:rotulo",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
